# Aura — environment variables for docker-compose
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored and never committed. These variables are consumed by
# docker-compose.yml's ${VAR} interpolation only — the Kubernetes deployment
# sources the equivalents from Secrets/ConfigMaps instead (see k8s/UPGRADE.md).

# ── Groq (Solis AI advisor) ─────────────────────────────────────────────────
# Two SEPARATE keys, one per app version — never reuse one key across both.
# Create keys at https://console.groq.com/keys
GROQ_API_KEY_SECURE=gsk_your_secure_version_key_here
GROQ_API_KEY_VULNERABLE=gsk_your_vulnerable_version_key_here

# Model ID used by both versions. Optional — docker-compose has a built-in
# fallback if this is unset, but that fallback may point at a deprecated
# model, so setting it explicitly is recommended.
# Options (checked against Groq's catalog): openai/gpt-oss-120b (best
# quality), openai/gpt-oss-20b (lighter/faster).
# Full list: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b

# ── Email (password-reset delivery, ENH-03) ─────────────────────────────────
# A Gmail address plus an App Password (NOT your account password —
# generate one at https://myaccount.google.com/apppasswords).
# Separate credentials per version, same as the Groq keys.
MAIL_USERNAME_SECURE=you@example.com
MAIL_PASSWORD_SECURE=your_gmail_app_password
MAIL_USERNAME_VULNERABLE=you@example.com
MAIL_PASSWORD_VULNERABLE=your_gmail_app_password
